# Teams Bridge for IsPilot - Environment Configuration

# ============================================================================
# Azure Bot Service Credentials (Required from Phase 1)
# ============================================================================
# From Azure AD App Registration: ftc-ispilot-corp-prod
# Reference: NEXT_STEPS.md → Phase 1

# Microsoft App ID (already obtained)
MICROSOFT_APP_ID=53ead9aa-24aa-44e7-b485-81a988e7492f

# Microsoft App Secret (Client Secret)
# ⚠️ STORE SECURELY - DO NOT COMMIT TO GIT
# To get this:
#   1. Go to Azure Portal → App registrations → ftc-ispilot-corp-prod
#   2. Navigate to Certificates & secrets
#   3. Copy the client secret VALUE (not ID)
#   4. Paste your secret below in your local .env file
# Note: .env file is in .gitignore - never commit it!
MICROSOFT_APP_PASSWORD=your-client-secret-here

# ============================================================================
# Google Cloud Configuration (Required)
# ============================================================================

# GCP Project ID
GOOGLE_CLOUD_PROJECT=corp-stro-salesinventory-prod

# ============================================================================
# IsPilot API Configuration (Required)
# ============================================================================

# IsPilot API endpoint
ISPILOT_API_ENDPOINT=https://ispilot-api-46y2f3tyja-uc.a.run.app/chat

# ============================================================================
# Server Configuration
# ============================================================================

# Server port
PORT=8080

# Enable debug mode (verbose logging)
DEBUG=False

# ============================================================================
# Notes
# ============================================================================
# 
# For local development:
#   1. Copy this file to .env
#   2. Fill in MICROSOFT_APP_ID and MICROSOFT_APP_PASSWORD from Azure
#   3. Run: python -m uvicorn main:app --reload
#
# For Cloud Run deployment:
#   All variables should be set via --set-env-vars flag
#   See: README.md → "Cloud Run Deployment"
#
