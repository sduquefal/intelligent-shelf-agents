      "botId": "53ead9aa-24aa-44e7-b485-81a988e7492f",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "commandLists": [
        {
          "scopes": [
            "personal",
            "team",
            "groupChat"
          ],
          "commands": [
            {
              "title": "Help",
              "description": "Show available commands"
            },
            {
              "title": "Status",
              "description": "Check store status and alerts"
            }
          ]
        }
      ],
      "isNotificationOnly": false,
      "supportsFiles": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "supportsAudio": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
