{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "53ead9aa-24aa-44e7-b485-81a988e7492f",
  "packageName": "com.ispilot.teams.bridge",
  "developer": {
    "name": "Retail Analytics Team",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "IsPilot",
    "full": "Intelligent Shelf Pilot - Analytics Bot"
  },
  "description": {
    "short": "AI-powered retail analytics assistant",
    "full": "IsPilot is an AI-powered assistant that provides shelf analytics, performance insights, and actionable recommendations for store operations."
  },
  "icons": {
    "outline": "icon-outline.png",
    "color": "icon-color.png"
  },
  "accentColor": "#004578",
